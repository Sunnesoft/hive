# A run of the reviews on a Claude model: eval/claude-shim.ts answers in NEAR AI's place (npm run eval:shim).
# No secret here, and no call goes to NEAR AI or to the chain.
NEAR_RPC=http://127.0.0.1:1
CONTRACT=swarm.test.near
RUNNER_ACCOUNT=runner.test.near
DEV_KEY=ed25519:none-the-run-signs-nothing
NEARAI_URL=http://127.0.0.1:8787/v1
NEARAI_API_KEY=local
PROTOCOL_MODEL=claude-haiku-5-5
EVAL_MODEL=claude-haiku-5-5
EVAL_DIR=eval/out/claude
STORE_DIR=eval/out/claude/store
TRACE_DIR=eval/out/claude/trace
AGENT_TIMEOUT_MS=600000
REVIEW_TIMEOUT_MS=10800000
