{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["node", "e2e", "scripts"]
}
