# Runner without a TEE (testnet). Never set DEV_KEY in the TEE deployment.
NEAR_RPC=https://rpc.testnet.fastnear.com
CONTRACT=swarm.sunnesoft.testnet
RUNNER_ACCOUNT=runner.sunnesoft.testnet
# from: scripts/swarm.sh dev-key
DEV_KEY=ed25519:...
NEARAI_API_KEY=sk-...
JUDGE_MODEL=z-ai/glm-5.3
MARKET_TOKEN=aat_...
# Optional. BID_USD: bid this much on USDC board jobs; unset means direct hires only.
# BID_USD=5.00
# SLOTS=3
# POLL_MS=30000
# AGENT_TIMEOUT_MS=120000
# IPFS_GATEWAY=https://w3s.link
