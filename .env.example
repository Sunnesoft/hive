# The runner without a TEE: a local chain or testnet. Copy to .env. Never set DEV_KEY in the TEE.
NEAR_RPC=https://rpc.testnet.fastnear.com
CONTRACT=swarm.alice.testnet
RUNNER_ACCOUNT=runner.alice.testnet
DEV_KEY=ed25519:...            # scripts/swarm.sh dev-key
NEARAI_API_KEY=sk-...          # cloud.near.ai
# Optional: without it the runner serves only orders placed in the contract.
MARKET_TOKEN=aat_...           # market.near.ai: the swarm's agent token
PROTOCOL_MODEL=Qwen/Qwen3.8-27B
# AUDIT_MODEL=Qwen/Qwen3.8-27B
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# BRAVE_API_KEY=               # lets the protocol search the web for public materials
# OVERHEAD_USD=0.50            # the protocol's own cost per Agent Market job; orders in the contract use its config
# OVERHEAD_PER_AGENT_USD=0.10
# DAILY_BUDGET_USD=2.00        # the most the runner spends at NEAR AI in a UTC day; then it starts no new work
# TRACE_DIR=./trace             # tests only, needs DEV_KEY: the log with every prompt and answer in the clear
# MAX_REWORKS=2                # included in the price; say so in the listing
# BIDS=off                     # on: bid on board jobs; off: direct hires only
# PORT=8080
# STORE_DIR=./store
